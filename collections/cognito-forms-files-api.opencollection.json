{
  "opencollection": "1.0.0",
  "info": {
    "name": "Cognito Forms Entries Files API",
    "version": "1.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "authorization_code",
      "authorizationUrl": "https://cognitoforms.com/api-connection",
      "accessTokenUrl": "https://cognitoforms.com/admin/oauthtoken",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Files",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get File",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://cognitoforms.com/api/files/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the file"
              }
            ]
          },
          "docs": "Gets a file by id."
        },
        {
          "info": {
            "name": "Upload File",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cognitoforms.com/api/files",
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "File",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Uploads a file to be used in form entries."
        }
      ]
    }
  ],
  "bundled": true
}