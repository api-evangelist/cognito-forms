          "name": "Get Form Entries",
          "request": {
            "name": "Get Form Entries",
            "description": {
              "content": "Get all of the entries for a specified view using OData.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "odata",
                "Forms({{form}})",
                "Views({{viewId}})",
                "Entries"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "$count",
                  "value": "<string>",
                  "description": "Include total count of entries"
                },
                {
                  "disabled": false,
                  "key": "$select",
                  "value": "<string>",
                  "description": "Returns list of entry IDs in a View when $select=Id is specified"
                }
              ],
